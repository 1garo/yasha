meta {
  name: Create Account
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/account
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body {
  {
    "firstName": "Alice",
    "lastName": "Carvalho",
    "email": "alice@example.com",
    "currency": "BRL"
  }
}

tests {
  test("returns 201", function() {
    expect(res.status).to.equal(201);
  });
}

script:post-response {
  bru.setVar("accountId", res.body.data);
}
